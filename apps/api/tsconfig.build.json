{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Emit src/main.ts as dist/main.js (what `start:prod` runs).
    "rootDir": "./src",
    // Keep the incremental cache inside dist/: `nest build` deletes dist/, and a
    // cache left outside it would make tsc skip emitting on the next build.
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
