// Prisma schema. Conventions: apps/api/prisma/CLAUDE.md
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  // Inside src/ so `nest build` compiles it with the rest of the app.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Schema placeholder so the first migration is not empty.
/// Replaced by Company / User in roadmap step 2.
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
